# forge-wp-update configuration. Copy to /etc/forge-wp-update/config and edit.
# This file is sourced by forge-wp-update as bash. Keep it valid bash.

# UNIQUE per server. Used in log lines. e.g. server-1.
SERVER_NAME="server-1"

# Root scanned for WordPress installs. Forge isolated users each get a home here.
SITES_ROOT="/home"

# Log file path.
LOG="/var/log/forge-wp-update.log"

# HTTP status codes treated as healthy after an update. Space separated.
HEALTHCHECK_CODES="200 301 302"

# Per-site exclude file. A file with this name in a site root lists plugin
# slugs (one per line) to never auto-update.
IGNORE_FILENAME=".forge-wp-update-ignore"

# Opt-in git commit. When set to 1, after a successful same-major update on a
# site that is a git repo, the updated plugin dirs are staged and committed.
# Assumes the repo root is the site root. Off by default.
COMMIT_AFTER_UPDATE=""
GIT_COMMIT_NAME="forge-wp-update"
GIT_COMMIT_EMAIL="forge-wp-update@localhost"

# Opt-in: push to the tracked remote after a successful commit. Never forced, so
# a diverged remote rejects the push (logged, run continues). Requires the site
# owner to have push credentials for the remote. Off by default.
PUSH_AFTER_COMMIT=""
